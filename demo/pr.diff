+@bp.post("/tasks/bulk_update")
+def bulk_update_tasks():
+    """
+    Update several tasks in one call.
+
+    PLANTED ISSUE #2 (untested code path): this endpoint has no test
+    coverage at all.
+    Body: {"updates": [{"id": 1, "completed": true}, ...]}
+    """
+    payload = request.get_json(force=True)
+    updates = payload.get("updates", [])
+    results = []
+    for u in updates:
+        task = db.update_task(u["id"], completed=bool(u.get("completed", False)))
+        if task is not None:
+            results.append(_serialize(task))
+    return jsonify(results)
